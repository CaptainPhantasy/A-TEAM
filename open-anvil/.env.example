# Open Anvil Configuration

# WebSocket server port (extension connects here)
ANVIL_PORT=7777

# Bind address (127.0.0.1 = localhost only, 0.0.0.0 = all interfaces)
ANVIL_HOST=127.0.0.1

# Tool call timeout in milliseconds
ANVIL_TIMEOUT=30000

# Debug mode (writes execution traces to debug/)
ANVIL_DEBUG=false

# State store path (for checkpoints and heartbeats)
ANVIL_STATE_DIR=./state
